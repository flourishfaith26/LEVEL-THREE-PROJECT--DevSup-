MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
PORT=5000

AUTH0_DOMAIN=<your-auth0-domain>
AUTH0_AUDIENCE=https://your-api-identifier

CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# DevSup In-Chat AI Assistant
GEMINI_API_KEY=<your-google-ai-studio-gemini-key>

# GitHub Developer OAuth (Optional, for profile verification & PR cards)
GITHUB_CLIENT_ID=<your-github-oauth-client-id>
GITHUB_CLIENT_SECRET=<your-github-oauth-client-secret>

# Optional TURN server for calls across restrictive mobile networks.
# Use coturn with TURN REST API/shared-secret authentication.
TURN_URLS=turn:your-turn-server.example:3478,turns:your-turn-server.example:5349
TURN_SHARED_SECRET=<your-turn-shared-secret>
TURN_CREDENTIAL_TTL_SECONDS=3600
